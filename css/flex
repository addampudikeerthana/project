<head>
    <style>
        .container {
            display: flex;
            flex-direction: row;
            gap: 20px;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: #f5f5f5;
            min-height: 300px;
            flex-wrap: wrap; /* Allows wrapping on smaller screens */
        }

        .box {
            width: 200px;
            height: 200px;
            border: 2px solid black;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s;
        }

        .box:hover {
            transform: scale(1.05);
        }

        .box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .box {
                width: 150px;
                height: 150px;
            }
        }
    </style>
</head>

<body>
    <h2>🌹 Rose Gallery - Flex Row Layout</h2>

    <div class="container">
        <div class="box"><img src="rose.jpg" alt="Red Rose"></div>
        <div class="box"><img src="rose.jpg" alt="Red Rose"></div>
        <div class="box"><img src="rose.jpg" alt="Red Rose"></div>
        <div class="box"><img src="rose.jpg" alt="Red Rose"></div>
    </div>
</body>