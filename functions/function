<html>
<head>
    <script>
        function changeColor(){
            document.getElementById('p1').style.color="red";
        }
        function hideDiv(){
            document.getElementById('d1').style.display="none";
        }
        function displayDate(){
            document.getElementById('h').innerHTML=newDate();
        }
        function displayName(){
            let name=document.getElementById('uname').value;
            document.getElementById('display').innerHTML="Welcome"+name;
        }
    </script>
</head>
<body>
<h1>Document Object Model(DOM)- document getElement By Id</h1>
<p id="p1">This is paragrapg . Apply color</p>
<div id="d1">This is div going to hidden </div>
<h3 id="h">This is header. for display Date</h3>
<br>
Name: <input type="text" id="uname">
<div id="display">Display name here</div>
<br><br>
<input type="button" value="Change Color" onclick="changeColor()">
<input type="button" value="Hide Div" onclick="hideDiv()">
<input type="button" value="Display Date" onclick="displayDate()">
<input type="button" value="Display Name" onclick="displayName()">

</body>
</html>